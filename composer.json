{
    "name": "juaniquillo/base-backend-component",
    "description": "Framework-agnostic base state for backend components: attributes, contents, settings, themes, paths and array serialization. You choose how your components render.",
    "keywords": [
        "juaniquillo",
        "base-backend-component",
        "backend-component"
    ],
    "homepage": "https://github.com/juaniquillo/base-backend-component",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Victor Sánchez",
            "email": "juaniquillo@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.89",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12",
        "rector/rector": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Juaniquillo\\BaseBackendComponent\\": "src"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Juaniquillo\\BaseBackendComponent\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "./vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php src tests",
        "format:check": "./vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff src tests",
        "rector": "vendor/bin/rector process",
        "rector:check": "vendor/bin/rector process --dry-run",
        "qa": [
            "@composer run analyse",
            "@composer run format:check",
            "@composer run rector:check",
            "@composer run test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
